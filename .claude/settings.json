{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/local.properties)",
      "Read(**/keystore.properties)",
      "Read(**/signing.properties)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p8)",
      "Read(**/*.mobileprovision)",
      "Read(**/*.provisionprofile)",
      "Read(**/*.emberbackup)",
      "Read(**/admin_token)",
      "Read(**/emberd.json)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.git-credentials)",
      "Read(~/.gradle/gradle.properties)",
      "Read(~/.android/*.keystore)",
      "Read(~/.android/adbkey)",
      "Read(~/Library/Keychains/**)",
      "Read(~/Library/MobileDevice/Provisioning Profiles/**)",
      "Read(~/Library/Application Support/EmberMesh/**)",
      "Read(~/.local/share/EmberMesh/**)"
    ]
  }
}
