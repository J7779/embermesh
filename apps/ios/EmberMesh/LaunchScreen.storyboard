                            <constraint firstItem="L0c-iv-001" firstAttribute="centerY" secondItem="L0c-vw-001" secondAttribute="centerY" id="L0c-c-002"/>
                            <constraint firstItem="L0c-iv-001" firstAttribute="width" secondItem="L0c-iv-001" secondAttribute="height" multiplier="1:1" id="L0c-c-003"/>
