   <TestAction
      buildConfiguration = "Debug"
      selectedDebuggerIdentifier = "Xcode.DebuggerFoundation.Debugger.LLDB"
      selectedLauncherIdentifier = "Xcode.DebuggerFoundation.Launcher.LLDB"
      shouldUseLaunchSchemeArgsEnv = "NO">
      <CommandLineArguments>
         <!-- XCTest symbolicates failure call stacks in-process by opening the object files named in
              the debug map (absolute paths in DerivedData / build/ios/core). When the repo lives in a
              macOS privacy-protected folder (such as ~/Documents or ~/Desktop) that open() can block
              forever inside the simulator, hanging the whole run on the first failing assertion. -->
         <CommandLineArgument
            argument = "-XCTDisableAggressiveSymbolication YES"
            isEnabled = "YES">
         </CommandLineArgument>
      </CommandLineArguments>
      <Testables>
         <TestableReference
            skipped = "NO">
