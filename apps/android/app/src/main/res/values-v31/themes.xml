<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Ember" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ember_bg</item>
        <!-- Android 12+ splash: the same logo the web boot animation starts from, on #17110f. -->
        <item name="android:windowSplashScreenBackground">@color/ember_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
        <item name="android:colorBackground">@color/ember_bg</item>
        <item name="android:colorPrimary">@color/ember_bg</item>
        <item name="android:colorPrimaryDark">@color/ember_bg</item>
        <item name="android:colorAccent">@color/ember_accent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <style name="Theme.Ember.Scanner" parent="Theme.Ember">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
