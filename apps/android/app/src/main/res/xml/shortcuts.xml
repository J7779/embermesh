<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:shortcutId="share_app" android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/share_app_short"
        android:shortcutLongLabel="@string/share_app_long">
        <intent android:action="org.embermesh.app.SHARE_APP"
            android:targetPackage="org.embermesh.app"
            android:targetClass="org.embermesh.app.ui.MainActivity" />
    </shortcut>
    <shortcut android:shortcutId="diagnostics" android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/diagnostics_short">
        <intent android:action="org.embermesh.app.DIAGNOSTICS"
            android:targetPackage="org.embermesh.app"
            android:targetClass="org.embermesh.app.ui.MainActivity" />
    </shortcut>
</shortcuts>
